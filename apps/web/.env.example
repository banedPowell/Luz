# Luz configuration (ADR 0003). Copy this file to .env for local development:
# the Nuxt CLI reads it in dev, but a built server only reads real environment
# variables. Nuxt casts values with destr, so wrap a value that looks like a
# number or JSON in double quotes inside single quotes: NUXT_DATA_DIR='"2026"'.

# Folder for Luz's own data (database, cookies, caches), created on first start.
# Relative paths are resolved from the working directory.
# Default when empty or unset:
#   Windows  %APPDATA%\Luz
#   macOS    ~/Library/Application Support/Luz
#   Linux    $XDG_DATA_HOME/luz, or ~/.local/share/luz
# Suggested for development, to keep dev data apart from your real data
# (.luz is ignored by git):
NUXT_DATA_DIR=.luz

# External tools: a command name looked up in the PATH, or an absolute path.
# Luz reads these paths; it does not run the tools at startup.
# NUXT_YT_DLP_PATH=yt-dlp
# NUXT_FFMPEG_PATH=ffmpeg
# NUXT_FFPROBE_PATH=ffprobe